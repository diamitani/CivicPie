# Environment Variables

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend
DATABASE_URL=postgresql://user:password@localhost/civicpie
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI/LLM APIs
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
MOONSHOT_API_KEY=your_moonshot_api_key

# Scraping
SCRAPY_USER_AGENT=CivicPie Bot (civic engagement platform)
SCRAPY_DELAY=1
CONGRESS_API_KEY=your_congress_api_key_here
OPENSTATES_API_KEY=your_openstates_api_key_here
PLAYWRIGHT_ENABLED=true

# Elected Officials Ingestion
OPENSTATES_API_KEY=your_openstates_v3_api_key
GOOGLE_CIVIC_API_KEY=your_google_civic_info_api_key
# Places API (New) - used by `enrich-places` (billed per request)
GOOGLE_MAPS_API_KEY=your_google_maps_places_api_key
PROPUBLICA_CONGRESS_API_KEY=your_propublica_congress_api_key
CONGRESS_GOV_API_KEY=your_congress_gov_api_key
# Optional: path to a local clone of unitedstates/congress-legislators for offline ingest
CONGRESS_LEGISLATORS_DIR=

# Security
SECRET_KEY=your-secret-key-here

# --- Added by backend QA: variables read by code but previously undocumented ---
# Vercel AI Gateway key (data-agent normalization)
AI_GATEWAY_API_KEY=
# model id for the data-agent
AI_GATEWAY_MODEL=
# api.census.gov key (data-agent)
CENSUS_API_KEY=
# local copy of Census national_county.txt (offline ingest)
CENSUS_COUNTY_FILE=
# api.open.fec.gov key (data-agent)
FEC_API_KEY=
# local copy of FJC judges.csv (offline ingest)
FJC_JUDGES_CSV=
# see code that reads it
NEXT_PUBLIC_AUTH_REDIRECT=
# see code that reads it
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# see code that reads it
NEXT_PUBLIC_COGNITO_DOMAIN=
# see code that reads it
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
# see code that reads it
NEXT_PUBLIC_DYNAMODB_ALERTS_TABLE=
# see code that reads it
NEXT_PUBLIC_DYNAMODB_PROFILES_TABLE=
# see code that reads it
NEXT_PUBLIC_SENTRY_DSN=
# see code that reads it
SENTRY_DSN=
# Master-data loader target (Supabase Postgres connection string); SUPABASE_DB_URL wins over DATABASE_URL for `load-master`
SUPABASE_DB_URL=
