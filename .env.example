# Environment Variables

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Backend
DATABASE_URL=postgresql://user:password@localhost/civicpie
REDIS_URL=redis://localhost:6379/0

# AI/LLM APIs
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Scraping
SCRAPY_USER_AGENT=CivicPie Bot (civic engagement platform)
SCRAPY_DELAY=1

# Elected Officials Ingestion
OPENSTATES_API_KEY=your_openstates_v3_api_key
GOOGLE_CIVIC_API_KEY=your_google_civic_info_api_key
PROPUBLICA_CONGRESS_API_KEY=your_propublica_congress_api_key
CONGRESS_GOV_API_KEY=your_congress_gov_api_key
# Optional: path to a local clone of unitedstates/congress-legislators for offline ingest
CONGRESS_LEGISLATORS_DIR=

# Security
SECRET_KEY=your-secret-key-here
